// Cloudflare Worker serving the static files in docs/ (vCard + landing page).
// worker.js runs first and fixes the headers of .vcf files for iPhones.
{
  "name": "cv-app",
  "compatibility_date": "2025-09-01",
  "main": "worker.js",
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
