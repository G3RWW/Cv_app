    <!-- CV and portfolio content -->
    <string name="cv_exp1_title">3D modelling and animation intern</string>
    <string name="cv_exp1_org">Iron Cat</string>
    <string name="cv_exp1_period">Oct 2026 – Jan 2027</string>
    <string name="cv_exp1_desc">392-hour internship: 3D modelling and animation for games in Blender and Unity.</string>
    <string name="cv_exp2_title">Unofficial team lead, gameplay programmer</string>
    <string name="cv_exp2_org">Vireka (team game project)</string>
    <string name="cv_exp2_desc">Led the team on a third-person cyberpunk slasher and wrote its C# systems in Unity (input, katana combat, dash, health, enemy waves); also made illustrations and design elements.</string>
    <string name="cv_exp3_title">Desktop app developer (personal project)</string>
    <string name="cv_exp3_org">PistonLauncher</string>
    <string name="cv_exp3_period">2026</string>
    <string name="cv_exp3_desc">Windows app launcher with session time tracking, categories, an always-on-top overlay with focus timer and reminders. Tauri (Rust + TypeScript), built with AI assistance.</string>
    <string name="cv_edu1_title">Multimedia and Computer Design (bachelor)</string>
    <string name="cv_edu1_org">Vilnius Gediminas Technical University (VILNIUS TECH)</string>
    <string name="cv_edu1_period">2023 – 2027 (expected)</string>
    <string name="cv_edu1_desc">Faculty of Fundamental Sciences, Department of Graphical Systems. Thesis: modelling the selection of AI agent behaviour strategies using an LLM in a blackboard architecture (turn-based Unity game).</string>
    <string name="cv_skill1_title">3D and animation</string>
    <string name="cv_skill1_desc">Blender, Maya, Substance Painter. Modelling, UV mapping, rigging, animation, texturing, shaders.</string>
    <string name="cv_skill2_title">Game development</string>
    <string name="cv_skill2_desc">Unity, C# (Input System, combat, enemy AI). Also Babylon.js, ArcGIS Maps SDK for JavaScript, Android Jetpack Compose (Kotlin).</string>
    <string name="cv_skill3_title">Design, illustration and video</string>
    <string name="cv_skill3_desc">Photoshop, Illustrator, Clip Studio Paint, Figma, Premiere Pro. Graphic design, digital illustration, video editing.</string>
    <string name="cv_skill4_title">Home automation and hardware</string>
    <string name="cv_skill4_desc">Home Assistant, Node-RED, MariaDB, Telegram bots, ESP-07 sensors, WLED.</string>
    <string name="cv_skill5_title">Languages</string>
    <string name="cv_skill5_desc">Lithuanian, English.</string>
    <string name="portfolio_3d_title">3D characters and animation</string>
    <string name="portfolio_3d_desc">Animated hero characters with weapon switching, face shaders, enemy creature animations and a game vehicle. More on ArtStation.</string>
    <string name="portfolio_vocaloid_title">Vocaloid-style character</string>
    <string name="portfolio_vocaloid_desc">Low-poly, Vocaloid-inspired character, modelled, rigged and animated. Tap Open to watch the animation on YouTube.</string>
    <string name="portfolio_luna_title">Luna</string>
    <string name="portfolio_luna_desc">Main character of Vireka: hero design and 3D model.</string>
    <string name="portfolio_vireka_title">Vireka</string>
    <string name="portfolio_vireka_desc">Team-made third-person cyberpunk slasher in Unity. I was the unofficial team lead, wrote the C# combat, dash, health and enemy wave systems, and made illustrations and design elements.</string>
    <string name="portfolio_terminai_title">Terminų Detektyvas</string>
    <string name="portfolio_terminai_desc">3D Unity game for learning Lithuanian IT terms, played as a chibi fox detective.</string>
    <string name="portfolio_piston_title">PistonLauncher</string>
    <string name="portfolio_piston_desc">Desktop launcher for creative apps: time tracking, categories, focus-timer overlay and daily habit streaks. Tauri (Rust + TypeScript).</string>
    <string name="portfolio_cvcard_title">CV Card</string>
    <string name="portfolio_cvcard_desc">This app: a business card with CV, portfolio and a contact form, in Lithuanian and English (Jetpack Compose).</string>

