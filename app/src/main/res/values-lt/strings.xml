    <string name="cv_exp1_title">3D modeliavimo ir animacijos praktikantas</string>
    <string name="cv_exp1_org">Iron Cat</string>
    <string name="cv_exp1_period">2026 m. spalis – 2027 m. sausis</string>
    <string name="cv_exp1_desc">392 valandų praktika: 3D modeliavimas ir animacija žaidimams su Blender ir Unity.</string>
    <string name="cv_exp2_title">Neoficialus komandos vadovas, žaidimo programuotojas</string>
    <string name="cv_exp2_org">Echelon 2134 (komandinis žaidimo projektas)</string>
    <string name="cv_exp2_desc">Vadovavau komandai kuriant kiberpanko „slasher“ žaidimą ir Unity aplinkoje parašiau jo C# sistemas: valdymą, kovą katana, „dash“, gyvybes ir priešų bangas.</string>
    <string name="cv_exp3_title">Android ir Wear OS programuotojas (asmeninis projektas)</string>
    <string name="cv_exp3_org">GlucoFace</string>
    <string name="cv_exp3_period">2025 – dabar</string>
    <string name="cv_exp3_desc">Laikrodžio ciferblatas ir telefono programėlė, rodanti gliukozės kiekį kraujyje realiu laiku. Kotlin, Watch Face Format, Wearable Data Layer.</string>
    <string name="cv_edu1_title">Multimedija ir kompiuterinis dizainas (bakalauras)</string>
    <string name="cv_edu1_org">Vilniaus Gedimino technikos universitetas (VILNIUS TECH)</string>
    <string name="cv_edu1_period">2023 – 2027 (numatoma)</string>
    <string name="cv_edu1_desc">Fundamentinių mokslų fakultetas, Grafinių sistemų katedra. Bakalauro darbas: DI agento elgsenos strategijų parinkimo modeliavimas taikant didelį kalbos modelį juodlentės architektūroje (ėjimais paremtas Unity žaidimas).</string>
    <string name="cv_skill1_title">3D ir animacija</string>
    <string name="cv_skill1_desc">Blender, Maya, Substance Painter. Modeliavimas, UV išklotinės, rigging, animacija, tekstūravimas, šešėliavimas.</string>
    <string name="cv_skill2_title">Žaidimų kūrimas</string>
    <string name="cv_skill2_desc">Unity, C# (Input System, kova, priešų DI). Taip pat Babylon.js, ArcGIS Maps SDK for JavaScript, Android Jetpack Compose (Kotlin).</string>
    <string name="cv_skill3_title">Dizainas, iliustracija ir vaizdo montažas</string>
    <string name="cv_skill3_desc">Photoshop, Illustrator, Clip Studio Paint, Figma, Premiere Pro. Grafinis dizainas, skaitmeninė iliustracija, vaizdo montažas.</string>
    <string name="cv_skill4_title">Namų automatika ir elektronika</string>
    <string name="cv_skill4_desc">Home Assistant, Node-RED, MariaDB, Telegram botai, ESP-07 jutikliai, WLED.</string>
    <string name="cv_skill5_title">Kalbos</string>
    <string name="cv_skill5_desc">Lietuvių, anglų.</string>
    <string name="portfolio_3d_title">3D personažai ir animacija</string>
    <string name="portfolio_3d_desc">Animuoti herojai su ginklų keitimu, veido šešėliavimas, priešų būtybių animacijos ir žaidimo transporto priemonė. Daugiau – ArtStation.</string>
    <string name="portfolio_echelon_title">Echelon 2134</string>
    <string name="portfolio_echelon_desc">Komandoje kurtas kiberpanko „slasher“ žaidimas. Vadovavau komandai ir Unity aplinkoje parašiau C# kovos, „dash“, gyvybių ir priešų bangų sistemas.</string>
    <string name="portfolio_vireka_title">Vireka</string>
    <string name="portfolio_vireka_desc">Komandoje kurtas trečiojo asmens žaidimas: sukūriau iliustracijas ir dizaino elementus.</string>
    <string name="portfolio_terminai_title">Terminų Detektyvas</string>
    <string name="portfolio_terminai_desc">3D Unity žaidimas lietuviškiems IT terminams mokytis, žaidžiama „chibi“ lapės detektyve.</string>
    <string name="portfolio_carbs_title">Angliavandenių skaičiuoklė</string>
    <string name="portfolio_carbs_desc">Web programėlės koncepcija žmonėms, sergantiems diabetu: reikalavimai, diagramos ir Figma prototipas.</string>
    <string name="portfolio_glucoface_title">GlucoFace</string>
    <string name="portfolio_glucoface_desc">Wear OS ciferblatas su gliukozės reikšme, tendencijos rodykle ir grafiku; duomenis siunčia telefono programėlė.</string>
    <string name="portfolio_cvcard_title">Vizitinė kortelė</string>
    <string name="portfolio_cvcard_desc">Ši programėlė: vizitinė kortelė su CV, portfolio ir kontaktų forma, lietuvių ir anglų kalbomis (Jetpack Compose).</string>

